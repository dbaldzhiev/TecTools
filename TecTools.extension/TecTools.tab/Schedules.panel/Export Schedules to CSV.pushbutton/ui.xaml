<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Export Schedules to CSV" Height="780" Width="900"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Export Schedules to CSV" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="InfoText" Style="{StaticResource Hint}" Text="Model: (loading...)"/>
        </StackPanel>

        <!-- Output -->
        <TextBlock Grid.Row="1" Text="Output" Style="{StaticResource SectionLabel}"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output folder:" VerticalAlignment="Center"/>
            <TextBox x:Name="FolderBox" Grid.Column="1" Margin="4" Padding="3"/>
            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Margin="4"
                    Click="on_browse_click"/>
        </Grid>
        <TextBlock x:Name="PreviewText" Grid.Row="3" Style="{StaticResource Hint}"
                   Text="Pick an output folder."/>

        <!-- Options -->
        <StackPanel Grid.Row="4">
            <CheckBox x:Name="OpenFolderCheck" Content="Open the output folder when export finishes"
                      IsChecked="True"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="A subfolder named '&lt;model name&gt;_&lt;timestamp&gt;' is created inside the output folder on every run, so repeated exports never overwrite each other."/>
        </StackPanel>

        <!-- Schedules header / filter -->
        <TextBlock Grid.Row="5" Text="Schedules" Style="{StaticResource SectionLabel}"/>
        <Grid Grid.Row="6" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Grid.Column="0" Margin="0,0,4,0" Padding="3"
                     ToolTip="Filter the list below by name"/>
            <Button x:Name="SelectAllButton" Grid.Column="1" Content="Select All" Margin="2"
                    Click="on_select_all_click"/>
            <Button x:Name="SelectNoneButton" Grid.Column="2" Content="Select None" Margin="2"
                    Click="on_select_none_click"/>
            <TextBlock x:Name="CountText" Grid.Column="3" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Style="{StaticResource Hint}" Margin="8,0,0,0" Text=""/>
        </Grid>

        <!-- Rows header -->
        <Grid Grid.Row="7" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="On" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="Schedule" FontWeight="Bold"/>
            <TextBlock Grid.Column="2" Text="Type" FontWeight="Bold"/>
            <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold"/>
        </Grid>

        <!-- Rows -->
        <ScrollViewer Grid.Row="8" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel"/>
        </ScrollViewer>

        <!-- Log -->
        <TextBlock Grid.Row="9" Text="Log" Style="{StaticResource SectionLabel}" VerticalAlignment="Top"/>
        <TextBox x:Name="LogBox" Grid.Row="9" Margin="0,24,0,0" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" Background="#F5F5F5"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Width="110" Margin="4" Padding="4"
                    Click="on_refresh_click"/>
            <Button x:Name="RunButton" Content="Export" Width="110" Margin="4" Padding="4"
                    Click="on_run_click"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Margin="4" Padding="4"
                    Click="on_close_click"/>
        </StackPanel>
    </Grid>
</Window>
